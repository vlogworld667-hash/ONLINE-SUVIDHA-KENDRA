# mail, smtp, or log. "log" writes messages to storage/mail.log.
MAIL_TRANSPORT="log"
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=587
SMTP_ENCRYPTION="tls"
SMTP_USERNAME=""
SMTP_PASSWORD=""

# Optional. Create a key at https://www.remove.bg/api

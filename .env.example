APP_NAME="Digital Seva"
APP_URL="http://localhost:8000"
APP_ENV="production"
APP_DEBUG=false
APP_TIMEZONE="Asia/Kolkata"

# Replace with a long random value before production.
JWT_SECRET="change-this-to-a-random-secret-with-at-least-32-characters"
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

DB_PATH="storage/app.sqlite"

CONTACT_TO_EMAIL=""
